PROJECT_NAME=gurbani-semantic-retrieval

DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EMBEDDING_DIR=data/embeddings
MODEL_DIR=models

SOURCE_DATASET=data/processed/final_gurbani_dataset_all_steeks.xlsx
RAAG_METADATA=data/metadata/raag_metadata.csv

# Steeks used to build training positives.
# bdb excluded: 99.9% byte-identical to ss.  pss excluded: padd-arth glossary, not a paraphrase.
TRAIN_STEEK_COLS=steek_ss,steek_ft,steek_ms
ALL_STEEK_COLS=steek_ss,steek_bdb,steek_ft,steek_ms,steek_pss

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Embedding tag used by semantic_search.py when --tag is not given.
# verse_hn (verse pairs + hard negatives) scored best on the 827-query gold set.
SEARCH_TAG=verse_hn

# Web search unit = pada. Pada vectors come from data/embeddings/pada_<PADA_TAG>/
# (pada = models/bge-m3-pada, trained on Colab). DIFF_K = size of the
# "same meaning, different words" section.
PADA_TAG=pada
DIFF_K=5

# LLM explanation layer (common/explain_match.py).
# Any OpenAI-compatible endpoint; default is Groq's free tier (console.groq.com).
# For Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=   <- put your key here in .env only; never in .env.example
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Short one-line reasons on every result card: one request per search, smaller
# model with its own free quota, so the detailed explanations keep theirs.
LLM_SUMMARY_MODEL=openai/gpt-oss-20b
# "Ask a question" writes long Punjabi explanations. By default it uses LLM_MODEL above;
# Gemini's free tier writes better Punjabi. To use it for questions only, set in .env:
# ASK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# ASK_LLM_MODEL=gemini-2.5-flash
# ASK_LLM_API_KEY=   <- .env only

TOP_K=10
RETRIEVAL_K=50
SEED=42

# Training-pair construction
TRAIN_FRAC=0.80
VAL_FRAC=0.10
TEST_FRAC=0.10
# Steeks shorter than this are dropped as degenerate queries.
MIN_STEEK_CHARS=15

# Pankati->Pankati gold set: a pair counts when BOTH commentators agree.
GOLD_THRESHOLD=0.35
GOLD_CEILING=0.97
MAX_GOLD_PER_QUERY=10
EVAL_SPLIT=test
DEVICE=auto
